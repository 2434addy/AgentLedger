# Server
PORT=3001
NODE_ENV=production

# Database — Neon PostgreSQL
# Get from: console.neon.tech → project → Connection Details → Pooled connection tab
# MUST use pooled connection string (contains ?pgbouncer=true)
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Database SSL — for Neon, download from: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# Paste the full PEM content as a single-line env var (replace newlines with \n)
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...

# Redis — Upstash
# Get from: console.upstash.com → database → Details → Redis URL
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=generate-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — set to your Cloudflare Pages URL
CORS_ORIGIN=https://agentledger.pages.dev

# HTTPS redirect — set to your Koyeb domain
ALLOWED_HOST=agentledger-api.koyeb.app

# App
API_KEY_PREFIX=al_live_sk_
