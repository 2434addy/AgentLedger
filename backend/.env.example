# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database — Neon PostgreSQL ────────────────────────────────────────────────
# Get from: console.neon.tech → project → Connection Details → Pooled connection tab
# MUST use pooled connection string (contains ?pgbouncer=true)
DATABASE_URL=postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true

# Database SSL CA certificate (optional but recommended for production)
# Download from: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# Paste full PEM content as single-line env var (replace newlines with \n)
# When set, enables full TLS certificate validation (rejectUnauthorized: true)
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...

# ─── Redis — Upstash ──────────────────────────────────────────────────────────
# Get from: console.upstash.com → database → Details → Redis URL
# Used for: per-API-key rate limiting
# Optional: falls back to in-memory rate limiting if not set
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# ─── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS & Hosts ─────────────────────────────────────────────────────────────
# Set CORS_ORIGIN to your frontend URL (Cloudflare Pages, Vercel, etc.)
CORS_ORIGIN=https://agentledger.pages.dev

# HTTPS redirect target — your backend's public hostname
ALLOWED_HOST=agentledger-api.koyeb.app

# Frontend URL — used for password reset links
FRONTEND_URL=https://agentledger.pages.dev

# ─── Email (for forgot-password) ──────────────────────────────────────────────
# Not yet integrated — reset links are logged in dev mode only.
# When implemented, use Resend, SendGrid, or any SMTP provider.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_xxxx

# ─── App ───────────────────────────────────────────────────────────────────────
API_KEY_PREFIX=al_live_sk_
